# Primeiro acesso: defina e-mail e senha antes da primeira execução.
ADMIN_EMAIL=operador@exemplo.com
ADMIN_PASSWORD=troque-por-uma-senha-longa
HOST=127.0.0.1
PORT=8080
DATABASE_PATH=./data/crm.sqlite3
# Em hospedagem HTTPS, defina COOKIE_SECURE=1 e mantenha o banco em volume persistente.
COOKIE_SECURE=0
# Integrações opcionais. Sem elas, importação e CRM continuam disponíveis.
APIFY_TOKEN=
FIRECRAWL_API_KEY=
GROQ_API_KEY=
RESEND_API_KEY=
# Integração anterior de e-mail; não é usada no acesso por WhatsApp.
# Configure exatamente no ambiente Production, após cadastrar o número do administrador.
CRM_PUBLIC_HOST=
# Mantenha proteção Standard da Vercel para as prévias.
CRM_PROTECTED_HOST=crm-ecom-ten.vercel.app
# O número do administrador é configurado na aba Acessos antes de liberar a produção.
# Chave aleatória longa opcional; na Vercel usa TURSO_AUTH_TOKEN se não definida.
CRM_ACCESS_SECRET=
# Na Vercel, configure as variáveis abaixo no painel (não neste arquivo).
# Vincule um banco Turso persistente antes de usar o CRM em produção.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

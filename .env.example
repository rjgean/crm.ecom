# Credenciais iniciais do único operador; defina valores reais somente na Vercel.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Banco persistente de leads: copie a URI privada Session pooler do projeto Supabase.
SUPABASE_DB_URL=
# Chave estável e aleatória (32+ caracteres) para cifrar credenciais de integrações.
CRM_CREDENTIALS_KEY=
# Opcional; na produção usa crm-ecom-ten.vercel.app por padrão.
CRM_PUBLIC_HOST=
# Chaves opcionais, que também podem ser salvas no painel após entrar.
APIFY_TOKEN=
FIRECRAWL_API_KEY=
GROQ_API_KEY=
# Execução local, sem SUPABASE_DB_URL, usa SQLite.
DATABASE_PATH=./data/crm.sqlite3
HOST=127.0.0.1
PORT=8080
